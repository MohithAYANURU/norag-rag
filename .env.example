# Copy this file to .env and replace with your real keys.

# For google gemini, go to https://aistudio.google.com/app/api-keys 
# and create an API key, then copy and paste it here.
LLM_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-3.5-flash-lite

# Optional: USD per 1 million tokens for the configured model.
# LLM_INPUT_USD_PER_1M=
# LLM_OUTPUT_USD_PER_1M=
